# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# development | production
FLASK_ENV_NAME=development

# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave

# Base de datos PostgreSQL (Neon). Si no la defines, se usa SQLite local (permanece_dev.db).
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Correos con Brevo (https://app.brevo.com > SMTP & API > API Keys). Sin esto, los correos
# no se envían y en pantalla se muestran los enlaces de invitación.
# BREVO_API_KEY=xkeysib-...
# CORREO_REMITENTE=tu-correo-verificado@gmail.com
# CORREO_NOMBRE=PERMANECE

# Dirección pública (para los enlaces de los correos). En local no hace falta.
# APP_URL=https://permanece.onrender.com
